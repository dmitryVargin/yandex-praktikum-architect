@startuml code_telemetry_classes

' UML class diagram (classes only) for telemetry-service

class TelemetryController {
  +create(dto: CreateReadingDto)
  +find(query: QueryReadingsDto)
}

class TelemetryService {
  -telemetryModel: Model<TelemetryReadingDocument>
  +create(dto: CreateReadingDto)
  +find(query: QueryReadingsDto)
}

class TemperaturePollerService {
  -logger: Logger
  -timer: NodeJS.Timeout
  +onModuleInit()
  +onModuleDestroy()
}

class KafkaController {
}

class TelemetryInitializer {
  +onModuleInit()
}

class TelemetryReading {
  +sensorId: string
  +timestamp: Date
  +value: number
  +unit: "C" | "F" | "HPa" | "Percent"
}

class TelemetryReadingDocument {
  +_id: any
  +sensorId: string
  +timestamp: Date
  +value: number
  +unit: "C" | "F" | "HPa" | "Percent"
}

class CreateReadingDto {
  +sensorId: string
  +timestamp?: Date
  +value: number
  +unit: "C" | "F" | "HPa" | "Percent"
}

class QueryReadingsDto {
  +sensorId?: string
  +from?: Date
  +to?: Date
  +limit?: number
}

class Model~T~ {
  +create(data: any): Promise<T>
  +find(filter: any): Query~T[]~
  +sort(criteria: any): Model~T~
  +limit(n: number): Model~T~
  +exec(): Promise<T[]>
}

class Logger {
  +log(message: string)
  +warn(message: string)
  +error(message: string)
}

' Relationships
TelemetryController --> TelemetryService : uses
TemperaturePollerService --> TelemetryService : uses
TelemetryService --> Model : uses
TelemetryService ..> CreateReadingDto
TelemetryService ..> QueryReadingsDto
TelemetryReadingDocument --|> TelemetryReading

@enduml