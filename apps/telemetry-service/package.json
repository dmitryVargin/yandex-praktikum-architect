{
  "name": "telemetry-service",
  "version": "1.0.0",
  "private": true,
  "description": "NestJS telemetry service for storing sensor readings in MongoDB time-series collection",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "postinstall": "node -e \"console.log('telemetry-service deps installed')\""
  },
  "dependencies": {
    "@nestjs/common": "10.4.5",
    "@nestjs/core": "10.4.5",
    "@nestjs/mongoose": "10.0.10",
    "@nestjs/platform-express": "10.4.5",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "kafkajs": "2.2.4",
    "@nestjs/microservices": "^10.4.5",
    "mongoose": "8.6.4",
    "reflect-metadata": "0.1.14",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.5.4",
    "ts-node": "10.9.2",
    "typescript": "5.6.2"
  },
  "engines": {
    "node": ">=18"
  }
}
